# Copy to .env.local for local development. Never commit .env.local.
# Without these, the site still works: GitHub and Google sign-in are disabled and the live demo is
# offered instead.

# Base URL of the Revokr Go API, e.g. http://localhost:8080 (no trailing slash needed). Server-only:
# there is no NEXT_PUBLIC_ prefix on purpose, so the address never reaches the browser.
# Leave it unset and the dashboard runs on built-in sample data with no backend. Once it is set the
# dashboard shows real incidents, and if the API is down it shows an error, never sample data.
REVOKR_API_URL=

# The public address of this site, e.g. https://main.d1234abcd.amplifyapp.com (scheme and host, no path).
# Set it on any deployment behind a proxy such as Amplify, where the app can't see its own public
# address: without it the OAuth redirect URI comes out as https://localhost:3000/... and Google and
# GitHub reject it. It must match the callback URLs registered with each provider. Leave it unset for
# local development.
SITE_URL=

# Signs session cookies and encrypts GitHub access tokens. Required for GitHub and Google sign-in.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# From the Revokr GitHub App's settings page (General > Client ID, Client secrets).
# In the App's settings, set "Callback URL" to <site origin>/api/auth/github/callback,
# e.g. http://localhost:3000/api/auth/github/callback for local development.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Web application).
# Add <site origin>/api/auth/google/callback under "Authorized redirect URIs",
# e.g. http://localhost:3000/api/auth/google/callback for local development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
