# Copy to .env and fill in real values locally. Never commit .env itself.

# --- API server ---
PORT=3000

# Shared secret the dashboard must send in the X-Revokr-Key header on every /api/* request.
# Leave it blank for local development and /api/* stays open. /health, /webhooks/github and
# /github/install/callback never need it. In ECS it is injected from Secrets Manager.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVOKR_API_KEY=

# --- Database (Amazon RDS PostgreSQL) ---
DB_HOST=
DB_PORT=5432
DB_NAME=revokr
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# --- AWS ---
AWS_REGION=
# Main account the API/worker run in
AWS_ACCOUNT_ID=
# Sandbox account that is the remediation target
SANDBOX_AWS_ACCOUNT_ID=
# ARN of RemediationSandboxRole, assumed via STS only when performing a remediation action
REMEDIATION_ROLE_ARN=
# IAM user in the sandbox account that real remediation is allowed to touch (see infra/notes.md)
REMEDIATION_TARGET_IAM_USERNAME=test-user

# --- SQS ---
SQS_QUEUE_URL=
SQS_DLQ_URL=

# --- Secrets Manager (ARNs only — never put actual secret values here) ---
GITHUB_APP_PRIVATE_KEY_SECRET_ARN=
GITHUB_WEBHOOK_SECRET_ARN=

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
# Stopgap PAT for the GitHub Actions secret update step (internal/incidents/rotate.go),
# until real per-installation GitHub App tokens exist. Needs the repo scope (Actions secrets).
GITHUB_TOKEN=

# --- Notifications (optional; leave both webhook lines blank to turn them off) ---
# Secrets Manager secret holding the Slack incoming-webhook URL. The URL is a credential.
NOTIFICATION_WEBHOOK_SECRET_ARN=
# Local dev only: the webhook URL itself instead of the ARN. Never commit a real one.
NOTIFICATION_WEBHOOK_URL=
# Lowest severity that posts: LOW, MEDIUM, HIGH or CRITICAL.
NOTIFY_MIN_SEVERITY=CRITICAL

# --- KMS ---
KMS_KEY_ID=

# --- Bedrock ---
BEDROCK_MODEL_ID=

# --- OpenAI (AI Incident Analyst — unconfirmed swap from Bedrock, see CLAUDE.md) ---
OPENAI_API_KEY=
